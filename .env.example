# Copy to .env and fill in. Never commit .env.

# Solana holders / RPC
HELIUS_API_KEY=
# Or full RPC URL (optional if HELIUS_API_KEY is set):
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=...
# Wallet / browser RPC proxy (POST /api/solana-rpc). Default on when HELIUS is set.
# SOLANA_RPC_PROXY=1
# SOLANA_RPC_PROXY_RATE_MAX=90
# SOLANA_RPC_PROXY_RATE_WINDOW=60

# Optional Solana / market
BIRDEYE_API_KEY=
SOLSCAN_API_KEY=
CMC_API_KEY=
X_BEARER_TOKEN=

# EVM holders (Ethereum / Base / … via Moralis or Etherscan; Robinhood via Blockscout)
MORALIS_API_KEY=
ETHERSCAN_API_KEY=
BLOCKSCOUT_API_KEY=
# Alchemy — create a Robinhood Chain app for Shared ETH / Fresh (robinhood-mainnet)
ALCHEMY_API_KEY=
# MadeOnSol — Robinhood launch-bundle intel (Bearer msk_… from madeonsol.com)
MADEONSOL_API_KEY=

# Website (python run_web.py)
WEB_API_TOKEN=
WEB_CORS_ORIGINS=
WEB_TRUST_PROXY=0

# RugWatch bridge (flag holders from local DB + cloud list)
# RUGWATCH_DB=C:\Users\levyr\RugWatch\data\rugwatch.db
# RUGWATCH_WALLETS_URL=https://raw.githubusercontent.com/YourUser/RugWatch/main/data/wallets_cloud.json
# RUGWATCH_GITHUB_REPO=YourUser/RugWatch
# RUGWATCH_GITHUB_PATH=data/wallets_cloud.json
# RUGWATCH_GITHUB_TOKEN=  # only if private repo (or use GITHUB_TOKEN)
